# Copy to .env.local and fill in. Without these, the example month, What's new
# (in `npm run dev` / `npm run preview`) and saving on this device all still work.

# Supabase: accounts and saved thoughts (Project settings → API). Public by design;
# row-level security keeps every row private to its owner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production What's new: the deployed news Edge Function, e.g.
# https://<project-ref>.supabase.co/functions/v1/news
# Leave empty to use /api/news from the Vite server.
VITE_NEWS_URL=

# Pay by UPI (no payment gateway): all three set turns it on, and the site then asks for
# a UPI payment instead of a Razorpay subscription. Public by design: a UPI ID is meant to be shared.
# Approve payments in Supabase: Table Editor > payments > set status to approved.
VITE_UPI_ID=
VITE_UPI_NAME=
VITE_UPI_AMOUNT=

# Which Google News edition to search, as COUNTRY:language (default IN:en).
NEWS_REGION=IN:en

# ---------------------------------------------------------------------------
# Server-side secrets. Set these on Supabase, never in the browser:
#   npx supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... \
#     RAZORPAY_PLAN_ID=... RAZORPAY_WEBHOOK_SECRET=... NEWS_REGION=IN:en ANTHROPIC_API_KEY=...
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_ID=          # a monthly plan for $1 (USD), created in the Razorpay dashboard
# RAZORPAY_WEBHOOK_SECRET=   # the secret you set on the webhook pointing at razorpay-webhook
# ANTHROPIC_API_KEY=         # for the analyze function: Claude reads each new thought
# ANALYZE_MODEL=             # optional; defaults to claude-haiku-5-5. claude-opus-5-5 reads more deeply and costs far more per thought
